# Réglages du travailleur (à copier dans /etc/howe-moderation-worker/worker.env, en 0600).
HOWE_URL=https://howe.immo
# Donnés une fois par « php artisan moderation:worker-add <nom> --capabilities=image » sur Howé.
WORKER_REFERENCE=
# Fichier en 0600 qui contient la clé privée (une ligne, base64).
WORKER_PRIVATE_KEY_FILE=/etc/howe-moderation-worker/worker.key
# image : photos et images des vidéos ; video : préparation (FFmpeg) ; asr : paroles (Faster-Whisper).
CAPABILITIES=image,video,asr
SLOTS=image=3,video=1,asr=1
TMP_DIR=/run/howe-moderation-worker
TESSERACT_CMD=tesseract
LEASE_WAIT=20
HEARTBEAT_SECONDS=20
MAX_DOWNLOAD_MB=30
TASK_MEMORY_MB=1024
TASK_CPU_SECONDS=120
# Vidéo (lot 4b).
FFMPEG_CMD=ffmpeg
FFPROBE_CMD=ffprobe
VIDEO_MEMORY_MB=3072
WHISPER_MODEL=small
ASR_THREADS=2
# 1 seulement au premier démarrage, si le modèle n'est pas déjà dans le cache.
WHISPER_DOWNLOAD=0
# Journal : info (tout le détail : chaque étape et chaque appel, avec sa durée), warning ou error.
LOG_LEVEL=info
